# Optional. Enables Firebase App Check (abuse protection for Firestore/Storage).
# Get this from Firebase Console -> App Check -> register this web app with the
# reCAPTCHA v3 provider. Leave unset and the app runs exactly as it does today.
VITE_RECAPTCHA_SITE_KEY=

# Optional. Your bot's @username (without the @), from BotFather. Only used to
# render an "Open bot & link" deep link in Settings -> Connect Telegram; the
# bot still works via /link CODE if this is left unset.
VITE_TELEGRAM_BOT_USERNAME=

# --- Server-side only (set these in the Vercel project's Environment
# Variables, NOT in this file / not prefixed with VITE_ - they must never
# reach the browser bundle). Required for the Telegram bot (api/telegram-webhook.ts):
#
# TELEGRAM_BOT_TOKEN
#   From @BotFather after creating your bot with /newbot.
#
# TELEGRAM_WEBHOOK_SECRET
#   Any random string you generate yourself. Must match the secret_token
#   passed to Telegram's setWebhook call (see README for the one-time setup).
#
# FIREBASE_SERVICE_ACCOUNT
#   Base64-encoded contents of a service account JSON key, from Firebase
#   Console -> Project Settings -> Service Accounts -> Generate new private
#   key. Encode with: base64 -i service-account.json | tr -d '\n'
#
# REMINDER_CHECK_SECRET
#   Any random string you generate yourself (e.g. `openssl rand -hex 20`).
#   Must ALSO be added as a GitHub Actions secret of the same name on this
#   repo (Settings -> Secrets and variables -> Actions) with the identical
#   value - the scheduled workflow in
#   .github/workflows/telegram-reminders.yml sends it on every request to
#   api/telegram-reminder-check.ts, which checks it the same way the
#   Telegram webhook checks TELEGRAM_WEBHOOK_SECRET.
