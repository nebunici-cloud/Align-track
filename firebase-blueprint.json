{
  "entities": {
    "UserSettings": {
      "title": "UserSettings",
      "description": "User aligner treatment settings and preferences",
      "type": "object",
      "properties": {
        "dailyTargetHours": { "type": "number" },
        "currentTray": { "type": "number" },
        "totalTrays": { "type": "number" },
        "trayDurationDays": { "type": "number" },
        "planStartDate": { "type": "string" },
        "planStartTime": { "type": "string" },
        "trayStartDate": { "type": "string" },
        "preferredTrayChangeTime": { "type": "string" },
        "orthodontistName": { "type": "string" },
        "clinicName": { "type": "string" },
        "doctorPhone": { "type": "string" },
        "nextApptDate": { "type": "string" },
        "nextApptTime": { "type": "string" },
        "chewiesDailyTargetMinutes": { "type": "number" },
        "useRubberBands": { "type": "boolean" },
        "rubberBandsTargetPerDay": { "type": "number" },
        "rubberBandsChangedToday": { "type": "number" },
        "outTimerAlertMinutes": { "type": "number" },
        "pushNotificationsEnabled": { "type": "boolean" },
        "soundAlertsEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      }
    },
    "WearLog": {
      "title": "WearLog",
      "description": "Wear/out logs for aligner tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "trayNumber": { "type": "number" },
        "type": { "type": "string" },
        "reason": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "notes": { "type": "string" },
        "dateStr": { "type": "string" }
      }
    },
    "MaintenanceTask": {
      "title": "MaintenanceTask",
      "description": "Daily maintenance tasks like cleaning aligners or chewies",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "completed": { "type": "boolean" },
        "category": { "type": "string" },
        "timeOfDay": { "type": "string" }
      }
    },
    "DiaryEntry": {
      "title": "DiaryEntry",
      "description": "Smile diary photos and notes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "trayNumber": { "type": "number" },
        "date": { "type": "string" },
        "photoUrl": { "type": "string" },
        "notes": { "type": "string" },
        "tightnessRating": { "type": "number" },
        "painLevel": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/users/{userId}/settings/{settingId}": {
      "schema": "UserSettings",
      "description": "User aligner settings"
    },
    "/users/{userId}/wearLogs/{logId}": {
      "schema": "WearLog",
      "description": "User wear/out log items"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "MaintenanceTask",
      "description": "User daily tasks"
    },
    "/users/{userId}/diaryEntries/{entryId}": {
      "schema": "DiaryEntry",
      "description": "User smile diary photos and notes"
    }
  }
}
